	)
	(text "Gate driver power supply only\nneeds to be able to deliver enough\nRMS current to switch ONE MOSFET at\nfull switching frequency (100kHz).\nBecause only two MOSFETS are ever on\nsimultaneuosly and only one of the\nMOSFETS is switching significantly\nhigher than the commutation frequency\nfor soft-chopping current control.\n\nSo gate driver supply must deliver around\n146 x 2 (safety factor) = 300mA RMS"
		(exclude_from_sim no)
		(at 162.306 152.908 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "b9be8688-7911-4484-acdd-488c65028e0a")
	)
	(text "12.6V max, 9V min (3S)"
		(exclude_from_sim no)
		(at 176.276 100.584 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left)
		)
		(uuid "dc2925b2-4c2c-4f9b-ba58-50e72d6e287f")
	)
	(text "Opamps have internal\nclamping diodes to protect\nagainst over/undervoltage.\n\nNo hardware LPF is performed\nbecause there would be a\nsignificant phase shift.\n"
		(exclude_from_sim no)
		(at 110.49 153.162 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "eef7cabc-0331-4b7e-a097-89e0d33ece91")
	)
